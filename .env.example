SCAMFLOW_ENVIRONMENT=development
SCAMFLOW_LOG_LEVEL=INFO

SCAMFLOW_DATABASE_PATH=data/scamflow.sqlite3
# Set DATABASE_URL (Railway PostgreSQL) in hosted production; do not commit it.
DATABASE_URL=
SCAMFLOW_SQLITE_BUSY_TIMEOUT_MS=5000

SCAMFLOW_SESSION_TTL_SECONDS=86400
SCAMFLOW_CASE_RETENTION_SECONDS=86400
SCAMFLOW_ASSESSMENT_TIMEOUT_SECONDS=2.0
SCAMFLOW_EXTRACTOR_MODE=rules
SCAMFLOW_MAX_REQUEST_BYTES=1000000
SCAMFLOW_RATE_LIMIT_PER_MINUTE=60
SCAMFLOW_AUTH_RATE_LIMIT_PER_MINUTE=10
SCAMFLOW_CLEANUP_INTERVAL_SECONDS=3600

SCAMFLOW_TRUSTED_ORIGIN=http://127.0.0.1:8000
# Set true when hosting the explicitly labelled development mock behind HTTPS.
SCAMFLOW_SECURE_COOKIES=false

# Optional shared reviewer credential. Leave blank to disable reviewer routes.
# Configure a long random secret through the deployment environment; do not commit it.
SCAMFLOW_REVIEWER_TOKEN=

# Container/deployment listener. Read by the Docker command, not Settings.
PORT=8000

# Optional provider credentials are intentionally absent. Rules-only mode is
# deterministic and credential-free; a provider adapter must be configured
# explicitly and must never fall back to a mock.
